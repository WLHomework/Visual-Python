{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Visual Python",
  "version": "0.1.0",
  "identifier": "com.visualpython.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43127",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Visual Python",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#f7f8fa",
        "shadow": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Visual Python",
        "width": 420,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#f7f8fa",
        "shadow": true,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Visual Python",
    "copyright": "Copyright (c) 2026 Visual Python",
    "category": "DeveloperTool",
    "shortDescription": "Python 与 Manim 图形化编程工作台",
    "longDescription": "通过图形化积木编写 Python 程序和 Manim 动画，并在桌面端完成运行、渲染与视频预览。",
    "fileAssociations": [
      {
        "ext": [
          "vpy"
        ],
        "name": "Visual Python Project",
        "description": "Visual Python 工程",
        "role": "Editor",
        "mimeType": "application/x-visual-python-project"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/language-server/": "language-server/",
      "../docs/manim-plugin/": "docs/manim-plugin/",
      "../docs/plugin-development/": "docs/plugin-development/"
    },
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "7bb65b3f-8540-58f4-b655-56b090b40cd4",
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Visual Python"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
