{
  "name": "visual-python",
  "private": true,
  "version": "0.1.0",
  "description": "A visual programming workbench for Python and Manim.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "npm run build && npm run prepare:language-server",
